{"log": {"version": "1.2", "creator": {"name": "revapi", "version": "0.1.0"}, "browser": {"name": "Chromium", "version": "Chrome/156.0.8078.79"}, "pages": [{"startedDateTime": "2026-11-14T01:22:28.349Z", "id": "page_1", "title": "http://127.0.0.1:8765/", "pageTimings": {}}], "entries": [{"_resourceType": "Document", "startedDateTime": "2026-11-14T01:22:28.349Z", "time": 2.814, "request": {"method": "GET", "url": "http://127.0.0.1:8765/", "httpVersion": "HTTP/1.0", "cookies": [], "headers": [{"name": "Accept", "value": "text/html,application/xhtml+xml,application/xml;q=0.9,image/jxl,image/avif,image/webp,image/apng,*/*;q=0.8,application/signed-exchange;v=b3;q=0.7"}, {"name": "Accept-Encoding", "value": "gzip, deflate, br, zstd"}, {"name": "Accept-Language", "value": "en-US,en;q=0.9"}, {"name": "Cache-Control", "value": "no-cache"}, {"name": "Connection", "value": "keep-alive"}, {"name": "Host", "value": "127.0.0.1:8765"}, {"name": "Pragma", "value": "no-cache"}, {"name": "Sec-Fetch-Dest", "value": "document"}, {"name": "Sec-Fetch-Mode", "value": "navigate"}, {"name": "Sec-Fetch-Site", "value": "none"}, {"name": "Sec-Fetch-User", "value": "?1"}, {"name": "Upgrade-Insecure-Requests", "value": "1"}, {"name": "User-Agent", "value": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) HeadlessChrome/156.0.0.0 Safari/537.36"}, {"name": "sec-ch-ua", "value": "\"Not:A-Brand\";v=\"8\", \"Chromium\";v=\"156\""}, {"name": "sec-ch-ua-mobile", "value": "?0"}, {"name": "sec-ch-ua-platform", "value": "\"Linux\""}], "queryString": [], "headersSize": -1, "bodySize": 0}, "response": {"status": 200, "statusText": "OK", "httpVersion": "HTTP/1.0", "cookies": [{"name": "sid", "value": "abc123"}], "headers": [{"name": "Content-Length", "value": "780"}, {"name": "Content-Type", "value": "text/html"}, {"name": "Date", "value": "Sat, 14 Nov 2026 01:22:28 GMT"}, {"name": "Server", "value": "BaseHTTP/0.6 Python/3.13.18"}, {"name": "Set-Cookie", "value": "sid=abc123; Path=/; HttpOnly"}], "content": {"size": 780, "mimeType": "text/html", "text": "<!doctype html><html><head><title>Todo Fixture</title></head><body>\n<h1>Todos</h1><ul id=list></ul>\n<input id=new placeholder=\"New todo\"><button id=add onclick=\"add()\">Add</button>\n<a href=\"/about\">About</a>\n<select id=filter><option value=all>All</option><option value=done>Done</option></select>\n<script>\nasync function load(){ const r = await fetch('/api/todos', {headers:{'X-Client':'fixture'}}); const j = await r.json();\n  document.getElementById('list').innerHTML = j.items.map(t=>'<li>'+t.title+'</li>').join(''); }\nasync function add(){ const v = document.getElementById('new').value;\n  await fetch('/api/todos', {method:'POST', headers:{'Content-Type':'application/json','X-Client':'fixture'}, body: JSON.stringify({title:v})}); load(); }\nload();\n</script></body></html>"}, "redirectURL": "", "headersSize": -1, "bodySize": 961}, "cache": {}, "timings": {"send": 0.045, "wait": 0.707, "receive": 2.062}, "serverIPAddress": "127.0.0.1", "pageref": "page_1"}, {"_resourceType": "Fetch", "startedDateTime": "2026-11-14T01:22:28.362Z", "time": 16.355, "request": {"method": "GET", "url": "http://127.0.0.1:8765/api/todos", "httpVersion": "HTTP/1.0", "cookies": [], "headers": [{"name": "sec-ch-ua-platform", "value": "\"Linux\""}, {"name": "Referer", "value": "http://127.0.0.1:8765/"}, {"name": "User-Agent", "value": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) HeadlessChrome/156.0.0.0 Safari/537.36"}, {"name": "sec-ch-ua", "value": "\"Not:A-Brand\";v=\"8\", \"Chromium\";v=\"156\""}, {"name": "sec-ch-ua-mobile", "value": "?0"}, {"name": "X-Client", "value": "fixture"}], "queryString": [], "headersSize": -1, "bodySize": 0}, "response": {"status": 200, "statusText": "OK", "httpVersion": "HTTP/1.0", "cookies": [], "headers": [{"name": "Content-Length", "value": "74"}, {"name": "Date", "value": "Sat, 14 Nov 2026 01:22:28 GMT"}, {"name": "Content-Type", "value": "applicat